{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Natalia Desktop",
  "version": "0.1.0",
  "identifier": "dev.natalia.desktop",
  "build": {
    "beforeDevCommand": "cd ../../ && npm run ts:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../../ && npm --workspace @natalia/web-shell run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Natalia Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
