        "packages/framework/runtime-config/src/index.ts"
      ],
      "@natalia/runtime-status": [
        "packages/framework/runtime-status/src/index.ts"
      ],
      "@natalia/plugin": ["packages/core/plugin/src/index.ts"],
      "@natalia/session": ["packages/framework/session/src/index.ts"],
      "@natalia/session-store": [
        "packages/framework/session-store/src/index.ts"
      ],
      "@natalia/plugin-tool-ask": ["packages/plugins/tools/ask/src/index.ts"],
