  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@natalia/agent": ["packages/agent/src/index.ts"],
      "@natalia/attachments": ["packages/attachments/src/index.ts"],
      "@natalia/capability": ["packages/capability/src/index.ts"],
      "@natalia/checkpoint": ["packages/checkpoint/src/index.ts"],
      "@natalia/collaboration": ["packages/collaboration/src/index.ts"],
      "@natalia/compaction": ["packages/compaction/src/index.ts"],
      "@natalia/config": ["packages/config/src/index.ts"],
      "@natalia/context-ledger": ["packages/context-ledger/src/index.ts"],
      "@natalia/governance-ledger": ["packages/governance-ledger/src/index.ts"],
      "@natalia/contracts": ["packages/contracts/src/index.ts"],
      "@natalia/example-ui-plugin": ["packages/example-ui-plugin/src/index.ts"],
      "@natalia/installer": ["packages/installer/src/index.ts"],
      "@natalia/plugin-local-tools": [
