{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@natalia/agent": ["packages/agent/src/index.ts"],
      "@natalia/agent-plugin": ["packages/agent-plugin/src/index.ts"],
      "@natalia/attachment-plugin": ["packages/attachment-plugin/src/index.ts"],
      "@natalia/builtin-tool-plugins": [
        "packages/builtin-tool-plugins/src/index.ts"
      ],
      "@natalia/checkpoint-plugin": ["packages/checkpoint-plugin/src/index.ts"],
      "@natalia/collaboration-plugin": [
        "packages/collaboration-plugin/src/index.ts"
      ],
      "@natalia/compaction-plugin": ["packages/compaction-plugin/src/index.ts"],
      "@natalia/config": ["packages/config/src/index.ts"],
      "@natalia/context-ledger-plugin": [
        "packages/context-ledger-plugin/src/index.ts"
      ],
      "@natalia/governance-ledger-plugin": [
        "packages/governance-ledger-plugin/src/index.ts"
      ],
      "@natalia/contracts": ["packages/contracts/src/index.ts"],
      "@natalia/installer": ["packages/installer/src/index.ts"],
      "@natalia/local-tools-plugin": [
        "packages/local-tools-plugin/src/index.ts"
      ],
      "@natalia/mcp": ["packages/mcp/src/index.ts"],
      "@natalia/mcp-plugin": ["packages/mcp-plugin/src/index.ts"],
      "@natalia/object-store": ["packages/object-store/src/index.ts"],
      "@natalia/native-terminal": ["packages/native-terminal/src/index.ts"],
      "@natalia/platform": ["packages/platform/src/index.ts"],
      "@natalia/provider-model-plugin": [
        "packages/provider-model-plugin/src/index.ts"
      ],
      "@natalia/runtime": ["packages/runtime/src/index.ts"],
      "@natalia/retry-plugin": ["packages/retry-plugin/src/index.ts"],
      "@natalia/runtime-config-plugin": [
        "packages/runtime-config-plugin/src/index.ts"
      ],
      "@natalia/runtime-ui-plugin": ["packages/runtime-ui-plugin/src/index.ts"],
      "@natalia/plugin": ["packages/plugin/src/index.ts"],
      "@natalia/session": ["packages/session/src/index.ts"],
      "@natalia/session-store-plugin": [
        "packages/session-store-plugin/src/index.ts"
      ],
      "@natalia/tool-ask": ["packages/tool-ask/src/index.ts"],
      "@natalia/tool-fs-read": ["packages/tool-fs-read/src/index.ts"],
      "@natalia/tool-fs-write": ["packages/tool-fs-write/src/index.ts"],
      "@natalia/tool-pdf": ["packages/tool-pdf/src/index.ts"],
      "@natalia/tool-search": ["packages/tool-search/src/index.ts"],
      "@natalia/tool-shell": ["packages/tool-shell/src/index.ts"],
      "@natalia/tool-web": ["packages/tool-web/src/index.ts"],
      "@natalia/tool-process": ["packages/tool-process/src/index.ts"],
      "@natalia/tool-terminal": ["packages/tool-terminal/src/index.ts"],
      "@natalia/tool-agent": ["packages/tool-agent/src/index.ts"],
      "@natalia/tool-sandbox": ["packages/tool-sandbox/src/index.ts"],
      "@natalia/tool-todo": ["packages/tool-todo/src/index.ts"],
      "@natalia/sandbox": ["packages/sandbox/src/index.ts"],
      "@natalia/sandbox-plugin": ["packages/sandbox-plugin/src/index.ts"],
      "@natalia/skills-plugin": ["packages/skills-plugin/src/index.ts"],
      "@natalia/subagent": ["packages/subagent/src/index.ts"],
      "@natalia/subagents-plugin": ["packages/subagents-plugin/src/index.ts"],
      "@natalia/task-workflow-plugin": [
        "packages/task-workflow-plugin/src/index.ts"
      ],
      "@natalia/terminal-plugin": ["packages/terminal-plugin/src/index.ts"],
      "@natalia/tools": ["packages/tools/src/index.ts"],
      "@natalia/turn-orchestration-plugin": [
        "packages/turn-orchestration-plugin/src/index.ts"
      ],
      "@natalia/work-ledger-plugin": [
        "packages/work-ledger-plugin/src/index.ts"
      ],
      "@natalia/workspace-plugin": ["packages/workspace-plugin/src/index.ts"],
      "@natalia/workflow-scheduler-plugin": [
        "packages/workflow-scheduler-plugin/src/index.ts"
      ]
    },
    "noUncheckedIndexedAccess": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun"]
  }
}
