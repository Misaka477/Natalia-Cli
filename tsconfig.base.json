      "@natalia/native-terminal": ["packages/native-terminal/src/index.ts"],
      "@natalia/platform": ["packages/platform/src/index.ts"],
      "@natalia/provider-model": ["packages/provider-model/src/index.ts"],
      "@natalia/runtime": ["packages/runtime/src/index.ts"],
      "@natalia/runtime-services": ["packages/runtime-services/src/index.ts"],
      "@natalia/retry": ["packages/retry/src/index.ts"],
      "@natalia/runtime-config": ["packages/runtime-config/src/index.ts"],
      "@natalia/runtime-status": ["packages/runtime-status/src/index.ts"],
      "@natalia/plugin": ["packages/plugin/src/index.ts"],
      "@natalia/session": ["packages/session/src/index.ts"],
      "@natalia/session-store": ["packages/session-store/src/index.ts"],
      "@natalia/plugin-tool-ask": ["packages/tool-ask/src/index.ts"],
      "@natalia/plugin-tool-fs-read": ["packages/tool-fs-read/src/index.ts"],
      "@natalia/plugin-tool-fs-write": ["packages/tool-fs-write/src/index.ts"],
      "@natalia/plugin-tool-pdf": ["packages/tool-pdf/src/index.ts"],
