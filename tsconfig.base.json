      "@natalia/plugin-tool-shell": ["packages/tool-shell/src/index.ts"],
      "@natalia/plugin-tool-web": ["packages/tool-web/src/index.ts"],
      "@natalia/plugin-tool-process": ["packages/tool-process/src/index.ts"],
      "@natalia/plugin-tool-terminal": ["packages/tool-terminal/src/index.ts"],
      "@natalia/plugin-tool-agent": ["packages/tool-agent/src/index.ts"],
      "@natalia/plugin-tool-sandbox": ["packages/tool-sandbox/src/index.ts"],
      "@natalia/plugin-tool-todo": ["packages/tool-todo/src/index.ts"],
      "@natalia/sandbox": ["packages/sandbox/src/index.ts"],
      "@natalia/plugin-skills": ["packages/skills-plugin/src/index.ts"],
      "@natalia/subagent": ["packages/subagent/src/index.ts"],
      "@natalia/subagents": ["packages/subagents/src/index.ts"],
      "@natalia/plugin-task-module": [
        "packages/task-module-plugin/src/index.ts"
      ],
      "@natalia/plugin-task-workflow": [
        "packages/task-workflow-plugin/src/index.ts"
      ],
      "@natalia/plugin-team": ["packages/team-plugin/src/index.ts"],
      "@natalia/tool-policy": ["packages/tool-policy/src/index.ts"],
      "@natalia/terminal": ["packages/terminal/src/index.ts"],
      "@natalia/tools": ["packages/tools/src/index.ts"],
      "@natalia/turn-orchestration": [
        "packages/turn-orchestration/src/index.ts"
      ],
      "@natalia/work-ledger": ["packages/work-ledger/src/index.ts"],
      "@natalia/workspace": ["packages/workspace/src/index.ts"],
      "@natalia/workflow": ["packages/workflow/src/index.ts"],
      "@natalia/workflow-scheduler": [
        "packages/workflow-scheduler/src/index.ts"
      ]
    },
    "noUncheckedIndexedAccess": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun"]
  }
